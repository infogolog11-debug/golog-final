# ============================================================
# إعدادات البيئة - Golog Travel API Server
# ============================================================
# 💡 طريقة الإعداد على Vercel:
#    1. اذهب إلى لوحة مشروعك → Settings → Environment Variables
#    2. أضف كل متغير أدناه مع قيمته الحقيقية (اختر Production + Preview + Development)
#    3. أعد نشر (Redeploy) المشروع لتطبيق المتغيرات
# ============================================================

# ============================================================
# 🔴 الأساسية — إلزامية للتشغيل
# ============================================================

# 1. قاعدة البيانات PostgreSQL (من Supabase أو Railway أو أي مزود)
# مثال: postgresql://user:pass@host:5432/db?schema=public
DATABASE_URL=

# 2. مفتاح أمان الجلسات — اُنشئ سلسلة عشوائية طويلة (مميز لكل بيئة!)
# مثال (توليد محلي): node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# 3. روابط التطبيق العامة
# 💡 على Vercel: إن كنت تستخدم الدومين الافتراضي (xxx.vercel.app) يمكنك ترك PUBLIC_URL فارغاً
#    وسيتم اكتشافه تلقائياً عبر متغير VERCEL_URL المُعرَّف تلقائياً.
# PUBLIC_URL=https://golog-final.vercel.app
WEB_ORIGIN=https://golog-final.vercel.app
COOKIE_SAME_SITE=lax

# ============================================================
# 🟡 المصادقة — ضرورية لتسجيل الدخول
# ============================================================

# 4. Google OAuth 2.0 (من Google Cloud Console)
#    رابط الـ Callback المطلوب: {PUBLIC_URL}/api/auth/google/callback
#    مثال: https://golog-final.vercel.app/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 5. بوت تيليجرام (من @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=GologApp_bot

# ============================================================
# 🟢 خيارات وصلاحيات
# ============================================================

# 6. الأدمن التلقائي — مفصول بفاصلة إن كان أكثر من بريد
ADMIN_EMAILS=admin@example.com

# ============================================================
# 🟤 التخزين - Supabase S3 Storage (لوثائق السائقين والملفات)
# ============================================================
# من لوحة Supabase → Project Settings → Storage → S3 Connection
SUPABASE_PROJECT_REF=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_S3_REGION=us-east-1
SUPABASE_STORAGE_BUCKET=golog

# ============================================================
# ⚫ Twilio SMS (اختياري — القناة الاحتياطية للإشعارات الحرجة)
# ============================================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ============================================================
# ⚪ سجلات السيرفر والبيئة
# ============================================================
LOG_LEVEL=info
NODE_ENV=production
