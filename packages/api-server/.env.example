# ============================================================
# ملف إعدادات البيئة لخادم الـ API - Golog (لنشر Vercel)
# ============================================================
# 🔴 مهم جداً: اترك هذه القيم فارغة هنا!
#    على Vercel يجب إدخال القيم الحقيقية يدوياً من:
#    Project Settings → Environment Variables
# ============================================================

# -----------------------------
# 1. قاعدة البيانات (POSTGRESQL) — إلزامي
# -----------------------------
DATABASE_URL=

# -----------------------------
# 2. أمان الجلسات — إلزامي
# -----------------------------
SESSION_SECRET=

# -----------------------------
# 3. روابط التطبيق على Vercel — عدّلها حسب رابط مشروعك
# -----------------------------
PUBLIC_URL=
WEB_ORIGIN=
COOKIE_SAME_SITE=lax

# -----------------------------
# 4. Google OAuth — مطلوب لتسجيل الدخول عبر Google
# -----------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# -----------------------------
# 5. بوت تيليجرام
# -----------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# -----------------------------
# 6. الأدمن التلقائي
# -----------------------------
ADMIN_EMAILS=

# -----------------------------
# 7. Supabase Storage
# -----------------------------
SUPABASE_PROJECT_REF=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_S3_REGION=
SUPABASE_STORAGE_BUCKET=

# -----------------------------
# 8. Twilio SMS (اختياري)
# -----------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# -----------------------------
# 9. سجلات السيرفر
# -----------------------------
LOG_LEVEL=info
