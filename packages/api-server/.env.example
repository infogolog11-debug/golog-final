# ============================================================
# إعدادات البيئة - Golog Travel API Server
# ============================================================
# 💡 طريقة الإعداد على Vercel:
#    1. اذهب إلى لوحة مشروعك → Settings → Environment Variables
#    2. أضف كل متغير أدناه مع قيمته الحقيقية (اختر Production + Preview + Development)
#    3. أعد نشر (Redeploy) المشروع لتطبيق المتغيرات
# ============================================================

# ============================================================
# 🔴 الأساسية — إلزامية للتشغيل الفعلي
# ============================================================

# 1. قاعدة البيانات PostgreSQL (من Supabase أو Railway أو أي مزود)
# مثال: postgresql://user:pass@host:5432/db?schema=public
DATABASE_URL=

# 2. مفتاح أمان الجلسات — مطلوب إجباريًا الآن!
#    ❌ بدون هذا المفتاح كل مستخدم سيُطرد تلقائيًا مع كل إعادة تشغيل/نشر.
#    اُنشئ سلسلة عشوائية طويلة (مميز لكل بيئة!)
#    مثال توليد محلي (انسخ الناتج هنا):
#       node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# 3. روابط التطبيق العامة
# 💡 على Vercel: إن كنت تستخدم الدومين الافتراضي (xxx.vercel.app) يمكنك ترك PUBLIC_URL فارغًا
#    وسيتم اكتشافه تلقائيًا عبر متغير VERCEL_URL المُعرَّف تلقائيًا.
# PUBLIC_URL=https://golog-final.vercel.app
# WEB_ORIGIN يُستخدم لقائمة الأصول المسموح لها بـ CORS + كوكي الجلسة (يفصل بفاصلة إن كان أكثر من واحد):
WEB_ORIGIN=https://golog-final.vercel.app
# خيارات: lax | none | strict
#   none   → مطلوب لـ OAuth Cross-Site + دواليب مختلفة (الافتراضي للإنتاج)
#   lax    → كافٍ لواجهة وباك-إند على نفس الدومين بالضبط أو للتطوير المحلي
COOKIE_SAME_SITE=none

# 4. رمز الأمان لـ /api/debug/db-sync (مطلوب لإنشاء الجداول بعد النشر يدويًا)
#    أنشئه بنفس الأمر الأعلى (randomBytes)، ولا تشاركه مع أحد:
DB_SYNC_SECRET=

# ============================================================
# 🟡 المصادقة — ضرورية لتسجيل الدخول
# ============================================================

# 5. Google OAuth 2.0 (من Google Cloud Console)
#    رابط الـ Callback المطلوب تضيفه في Google Cloud:
#       {PUBLIC_URL}/api/auth/google/callback
#    مثال عملي: https://golog-final.vercel.app/api/auth/google/callback
#    وتأكد أيضًا من إضافة نطاق المشروع إلى Authorized JavaScript origins:
#       https://golog-final.vercel.app
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 6. بوت تيليجرام (من @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=GologApp_bot

# ============================================================
# 🟢 خيارات وصلاحيات
# ============================================================

# 7. الأدمن التلقائي — مفصول بفاصلة إن كان أكثر من بريد
#    (عند أول تسجيل دخول لأي من هذه العناوين يصبح isAdmin=true تلقائيًا)
ADMIN_EMAILS=admin@example.com

# ============================================================
# 🟤 التخزين - Supabase S3 Storage (لوثائق السائقين والملفات)
# ============================================================
# من لوحة Supabase → Project Settings → Storage → S3 Connection
SUPABASE_PROJECT_REF=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_S3_REGION=us-east-1
SUPABASE_STORAGE_BUCKET=golog

# ============================================================
# ⚫ Twilio SMS (اختياري — القناة الاحتياطية للإشعارات الحرجة)
# ============================================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ============================================================
# ⚫ إعدادات متقدمة قاعدة البيانات (اختيارية — عادةً لا تحتاج تعديلها)
# ============================================================
# اضفها بـ "true" فقط إذا كان مزود قاعدة البيانات يتطلب تعطيل SSL
# (مثل قاعدة بيانات محليّة بدون شهادة). معظم المزودين السحابيين (Supabase/Neon/Railway) يحتاجونها فارغة.
# DB_DISABLE_SSL=true

# ============================================================
# ⚪ سجلات السيرفر والبيئة
# ============================================================
LOG_LEVEL=info
NODE_ENV=production
