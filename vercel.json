{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/health",                      "destination": "/api/health" },
    { "source": "/api/debug/:path*",                "destination": "/api/health" },
    { "source": "/api/auth/google/callback",         "destination": "/api/auth_google_callback" },
    { "source": "/api/auth/google",                  "destination": "/api/auth_google" },
    { "source": "/api/auth/:path*",                 "destination": "/api/_catch_all" },
    { "source": "/api/users/:path*",                "destination": "/api/_catch_all" },
    { "source": "/api/trips/:path*",                "destination": "/api/_catch_all" },
    { "source": "/api/bookings/:path*",             "destination": "/api/_catch_all" },
    { "source": "/api/parcels/:path*",              "destination": "/api/_catch_all" },
    { "source": "/api/messages/:path*",             "destination": "/api/_catch_all" },
    { "source": "/api/ratings/:path*",              "destination": "/api/_catch_all" },
    { "source": "/api/driver-verification/:path*",  "destination": "/api/_catch_all" },
    { "source": "/api/referrals/:path*",            "destination": "/api/_catch_all" },
    { "source": "/api/earnings/:path*",             "destination": "/api/_catch_all" },
    { "source": "/api/notifications/:path*",        "destination": "/api/_catch_all" },
    { "source": "/api/admin/:path*",                "destination": "/api/_catch_all" },
    { "source": "/api/reports/:path*",              "destination": "/api/_catch_all" },
    { "source": "/api/public/:path*",               "destination": "/api/_catch_all" },
    { "source": "/api/matching/:path*",             "destination": "/api/_catch_all" },
    { "source": "/api/driver/:path*",               "destination": "/api/_catch_all" },
    { "source": "/api/rider/:path*",                "destination": "/api/_catch_all" },
    { "source": "/api/:path*",                      "destination": "/api/_catch_all" },
    { "source": "/api",                              "destination": "/api/index" },
    { "source": "/_vercel/:path*",                 "destination": "/_vercel/:path*" },
    { "source": "/(.*\\.(?:css|js|mjs|cjs|map|png|jpg|jpeg|gif|webp|avif|svg|ico|woff2?|woff|ttf|otf|eot|json|txt|xml|webmanifest|html)$)", "destination": "/$1" },
    { "source": "/(.*)",                            "destination": "/index.html" }
  ]
}
