{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "public",
  "functions": {
    "api/index.ts": { "maxDuration": 30 }
  },
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ],
  "rewrites": [
    /* ============================================================
       الإصلاح الأهم والأقوى على الإطلاق للـ Express على Vercel:
       نُجبر 100% من الطلبات التي تبدأ بـ /api/ على المرور إلى
       الملف الوحيد api/index.ts — لا نعتمد على Vercel File Router
       أصلاً في مطابقة مسارات الـ API، فلا يوجد أي مجال لخطأ
       مطابقة أو تعارض أولويات أو 404 عشوائي في أي مسار مهما كان
       عميقاً مثل /api/auth/google/callback أو /api/users/me/switch-role.
       ملاحظة: مصفوفة rewrites تُطبّق من الأعلى للأسفل (ترتيب الأولويات)
       لذا يجب أن تكون قاعدة الـ API قبل قاعدة الـ SPA Fallback.
       ============================================================ */
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/api",
      "destination": "/api/index.ts"
    },
    /* قاعدة الـ SPA العادية لباقي الطلبات (الواجهة الأمامية) */
    {
      "source": "/((?!_next/|_static/|_vercel|[\\w-]+\\.[\\w-]+).*)",
      "destination": "/index.html"
    }
  ]
}
